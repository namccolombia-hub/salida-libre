# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Claude Code local tool state — not project source
.claude/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android build artifacts (regenerated by Gradle — do not commit)
android/app/build
android/build
android/.gradle
android/local.properties
android/captures
android/*.iml

# iOS build artifacts (regenerated by CocoaPods/Xcode — do not commit)
ios/App/Pods
ios/App/output
ios/App/build
ios/App/App.xcworkspace/xcuserdata
ios/**/*.xcuserstate
ios/.build

# Signing keys, certificates, secrets — NEVER commit these
*.keystore
*.jks
*.p12
*.mobileprovision
.env
.env.local
.env.*.local
